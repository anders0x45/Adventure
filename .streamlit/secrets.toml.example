# DayRise Adventures - Secrets Configuration
# Copy this file to .streamlit/secrets.toml and fill in your values

# Admin passcode for accessing the admin dashboard (REQUIRED)
# Change this to a secure passcode before deploying!
admin_passcode = "changeme123"

# Database URL (OPTIONAL)
# For local development, leave unset to use SQLite (dayrise.db)
# For production on Streamlit Community Cloud, set to a hosted Postgres URL:
# DATABASE_URL = "postgresql://user:password@host:port/dbname"
# Example for Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# Example for Neon: postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname
# DATABASE_URL = ""